# Copy this file to backend/.env and fill in your key. The server reads it;
# the browser never sees it.

ANTHROPIC_API_KEY=
# Any Claude API model id. You choose. Current Sonnet is claude-sonnet-5-5.
ANTHROPIC_MODEL=

# Optional. Defaults to 4096.
MAX_TOKENS=4096

# Prompt-cache lifetime. 5m (default) or 1h.
# 1h cache writes cost 2x base input tokens. The 5-minute cache is refreshed
# on each hit; coming back to the center node after more than 5 minutes is
# usually a cache miss on the default TTL.
CACHE_TTL=5m

# Server-side threshold compaction (beta compact-2026-01-12).
# Minimum the API accepts is 50000. Default matches the API default.
COMPACT_TRIGGER_TOKENS=150000
